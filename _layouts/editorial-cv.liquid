---
layout: editorial
---
<div class="cv-content">
  <div class="cv-download"><a class="cv-download-button" href="{{ '/assets/pdf/lorenzo_cv.pdf' | relative_url }}" download="Lorenzo-Sileci-CV.pdf">Download CV</a></div>
  {% for section in site.data.cv %}
    <section class="cv-section" aria-labelledby="cv-{{ section.id }}">
      <h2 id="cv-{{ section.id }}">{{ section.title | escape }}</h2>
      <div class="cv-entries">
        {% for entry in section.entries %}
          <div class="cv-entry">
            <p class="cv-dates">{{ entry.dates | escape }}</p>
            <div class="cv-entry-body">
              <h3 class="cv-position">{{ entry.title | escape }}</h3>
              <p class="cv-institution">{{ entry.institution | escape }}</p>
              {% if entry.department %}<p class="cv-department">{{ entry.department | escape }}</p>{% endif %}
              {% for note in entry.notes %}<p class="cv-note">{{ note | escape }}</p>{% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
