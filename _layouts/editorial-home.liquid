---
layout: editorial
---
<div class="hero">
  <div class="hero-map" aria-hidden="true">{% include editorial/map.liquid %}</div>
  <div class="hero-copy">
    <h1 class="hero-name">Lorenzo<br>Sileci</h1>
    <div class="introduction">
      <img class="portrait" src="{{ '/assets/img/identity/portrait.webp' | relative_url }}" alt="Lorenzo Sileci" width="512" height="512">
      <div><p class="appointment">Assistant Professor<br>of Economics</p><p class="institution">IE University · Madrid</p></div>
    </div>
    <nav class="profile-icons" aria-label="Professional profiles and CV">
      {% for profile in site.data.profile_links %}
        {% assign icon_path = 'editorial/icons/' | append: profile.icon | append: '.svg' %}
        {% assign profile_href = profile.url %}{% if profile.icon == 'cv' %}{% assign profile_href = profile_href | relative_url %}{% endif %}
        <a href="{{ profile_href | escape }}" aria-label="{{ profile.label | escape }}" title="{{ profile.label | escape }}" data-profile="{{ profile.icon }}"{% if profile.icon == 'cv' %} download="Lorenzo-Sileci-CV.pdf"{% elsif profile.icon != 'email' %} target="_blank" rel="noopener"{% endif %}>{% include {{ icon_path }} %}</a>
      {% endfor %}
    </nav>
  </div>
  <section class="hero-about" id="about" aria-labelledby="hero-about-heading">
    <h2 id="hero-about-heading">about me</h2><div class="hero-biography">{{ content }}</div>
  </section>
</div>
<section class="home-section">
  <div class="section-heading"><h2>selected research</h2><nav class="research-links" aria-label="Explore research"><a href="{{ '/publications/' | relative_url }}">publications ↗</a><a href="{{ '/current-research/' | relative_url }}">current research ↗</a></nav></div>
  {% for key in site.data.featured_research %}{% assign paper = site.data.research_entries[key] %}{% include editorial/paper.liquid paper=paper %}{% endfor %}
</section>
